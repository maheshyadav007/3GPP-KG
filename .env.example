THREEGPP_CONFIG_DIR=
THREEGPP_DATABASE_MODE=sql
THREEGPP_DATABASE_URL=postgresql+asyncpg://localhost:5432/threegpp
THREEGPP_DATABASE_PREVIEW_DATASET_VERSION=
THREEGPP_OBJECT_STORE_BACKEND=local
THREEGPP_OBJECT_STORE_LOCAL_PATH=./data/artifacts
THREEGPP_HTTP_REQUESTS_PER_SECOND=1.0
THREEGPP_HTTP_MAX_CONCURRENCY=4
THREEGPP_PARSER_DOCUMENT_WORKERS=4
THREEGPP_LEGACY_CONVERTER=auto
THREEGPP_EMBEDDING_PROVIDER=openai_compatible
THREEGPP_EMBEDDING_BASE_URL=
THREEGPP_EMBEDDING_MODEL=
THREEGPP_EMBEDDING_DIMENSIONS=1024
THREEGPP_EMBEDDING_API_KEY=
THREEGPP_RERANK_PROVIDER=openai_compatible
THREEGPP_RERANK_BASE_URL=
THREEGPP_RERANK_MODEL=
THREEGPP_RERANK_API_KEY=
THREEGPP_GENERATION_PROVIDER=openai_compatible
THREEGPP_GENERATION_BASE_URL=
THREEGPP_GENERATION_MODEL=
THREEGPP_GENERATION_API_KEY=
THREEGPP_TOPIC_EXTRACTION_ENABLED=false
THREEGPP_NEWSLETTER_GENERATION_ENABLED=false
THREEGPP_OIDC_ISSUER=
THREEGPP_OIDC_AUDIENCE=threegpp-evidence-graph
THREEGPP_AUTH_REQUIRED=true
